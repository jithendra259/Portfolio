{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd frontend && pnpm run build",
  "installCommand": "cd frontend && pnpm install",
  "outputDirectory": "frontend/.next",
  "rewrites": [
    {
      "source": "/api/py/:path*",
      "destination": "/api/index.py"
    }
  ]
}
