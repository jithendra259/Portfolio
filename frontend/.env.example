# Enviroment variables needed to connect to the LiveKit server.
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# Leave AGENT_NAME blank to enable automatic dispatch
# Provide an agent name to enable explicit dispatch
AGENT_NAME=

# Render Backend Service (Health check & keep-alive ping)
NEXT_PUBLIC_RENDER_BACKEND_URL=https://portfolio-backend-ljlv.onrender.com

# Meeting Confirmation Email (Gmail SMTP or any custom SMTP)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=kandulajithendrasubramanyam@gmail.com
GMAIL_APP_PASSWORD=your-16-char-gmail-app-password
# Optional custom SMTP override:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Permanent Google Meet Room:
# Go to https://meet.google.com -> "New meeting" -> "Create a meeting for later" -> paste link below:
GOOGLE_MEET_LINK=https://meet.google.com/your-permanent-code

# Optional: Google Calendar API (OAuth 2.0) for dynamic per-meeting creation:
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token

